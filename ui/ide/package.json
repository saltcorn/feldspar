{
  "name": "@saltcorn/ide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Saltcorn file-store IDE — the VS Code workbench embedded on its own admin route, over @codingame/monaco-vscode-api (design §12.1).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "gen-client": "cargo run -q -p sc-api --example emit_admin_client -- src/client.ts"
  },
