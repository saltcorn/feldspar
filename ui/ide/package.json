    "@codingame/monaco-vscode-dialogs-service-override": "^36.2.7",
    "@codingame/monaco-vscode-editor-api": "^36.2.7",
    "@codingame/monaco-vscode-explorer-service-override": "^36.2.7",
    "@codingame/monaco-vscode-extension-api": "^36.2.7",
