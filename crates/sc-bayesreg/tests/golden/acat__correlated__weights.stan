// acat: y | weights(w) ~ x + (1 + x | g)
// Generated by feldspar's bayesian_regression provider (generator 1).
// The program depends only on the model's structure: names, counts and prior
// numbers are data.
// structure: {"generator":1,"family":"acat","predictors":[{"dpar":"mu","link":"logit","intercept":"thresholds","b":"free","offset":false}],"scalars":[],"blocks":[{"correlated":true,"parts":[0]}],"response":{"weights":"column"}}
functions {
  // The prior menu (code -> density); a prior on a bounded parameter is truncated
  // there, and the truncation's constant (data) is left out.
  real prior_lpdf(real x, int code, array[] real a) {
    if (code == 0) {
      return 0;
    } else if (code == 1) {
      return normal_lpdf(x | a[1], a[2]);
    } else if (code == 2) {
      return student_t_lpdf(x | a[1], a[2], a[3]);
    } else if (code == 3) {
      return cauchy_lpdf(x | a[1], a[2]);
    } else if (code == 4) {
      return double_exponential_lpdf(x | a[1], a[2]);
    } else if (code == 5) {
      return logistic_lpdf(x | a[1], a[2]);
    } else if (code == 6) {
      return exponential_lpdf(x | a[1]);
    } else if (code == 7) {
      return gamma_lpdf(x | a[1], a[2]);
    } else if (code == 8) {
      return inv_gamma_lpdf(x | a[1], a[2]);
    } else if (code == 9) {
      return lognormal_lpdf(x | a[1], a[2]);
    } else if (code == 10) {
      return uniform_lpdf(x | a[1], a[2]);
    } else if (code == 11) {
      return beta_lpdf(x | a[1], a[2]);
    }
    reject("no prior has the code ", code);
  }
  real priors_lpdf(vector x, array[] int code, array[,] real a) {
    real lp = 0;
    for (i in 1:rows(x)) {
      lp += prior_lpdf(x[i] | code[i], a[i]);
    }
    return lp;
  }
  // The logit link's log CDF and its complement.
  real ord_lF(real x) {
    return log_inv_logit(x);
  }
  real ord_l1mF(real x) {
    return log1m_inv_logit(x);
  }
  // The log probability of each category of the acat model.
  vector ord_lprobs(real eta, vector thres, real disc) {
    int K = rows(thres) + 1;
    vector[K] lp;
    vector[K - 1] up;
    vector[K - 1] down;
    for (j in 1:(K - 1)) {
      real x = disc * (eta - thres[j]);
      up[j] = ord_lF(x);
      down[j] = ord_l1mF(x);
    }
    for (k in 1:K) {
      lp[k] = sum(up[1:(k - 1)]) + sum(down[k:(K - 1)]);
    }
    lp -= log_sum_exp(lp);
    return lp;
  }
}
data {
  int<lower=1> N;
  int<lower=1> nthres;
  array[N] int<lower=1, upper=nthres + 1> Y;
  vector<lower=0>[N] weights;
  int<lower=0> K_1;
  matrix[N, K_1] X_1;
  array[K_1] int prior_b_1_code;
  array[K_1, 3] real prior_b_1_args;
  int prior_Intercept_1_code;
  array[3] real prior_Intercept_1_args;
  int<lower=1> N_1;
  array[N] int<lower=1, upper=N_1> J_1;
  int<lower=1> M_1_1;
  matrix[N, M_1_1] Z_1_1;
  array[M_1_1] int prior_sd_1_code;
  array[M_1_1, 3] real prior_sd_1_args;
  real<lower=0> prior_cor_1_eta;
}
transformed data {
  vector[K_1] means_X_1;
  matrix[N, K_1] Xc_1;
  for (i in 1:K_1) {
    means_X_1[i] = mean(X_1[, i]);
    Xc_1[, i] = X_1[, i] - means_X_1[i];
  }
}
parameters {
  vector[K_1] b_1;
  vector[nthres] Intercept_c_1;
  vector<lower=0>[M_1_1] sd_1;
  matrix[M_1_1, N_1] z_1;
  cholesky_factor_corr[M_1_1] L_1;
}
transformed parameters {
  matrix[N_1, M_1_1] r_1;  // the group-level effects
  r_1 = (diag_pre_multiply(sd_1, L_1) * z_1)';
}
model {
  vector[N] eta_1 = Xc_1 * b_1;
  eta_1 += rows_dot_product(r_1[J_1], Z_1_1);
  vector[N] mu = eta_1;
  for (n in 1:N) {
    target += weights[n] * (ord_lprobs(eta_1[n], Intercept_c_1, 1)[Y[n]]);
  }
  target += priors_lpdf(b_1 | prior_b_1_code, prior_b_1_args);
  for (i in 1:(nthres)) {
    target += prior_lpdf(Intercept_c_1[i] | prior_Intercept_1_code, prior_Intercept_1_args);
  }
  target += priors_lpdf(sd_1 | prior_sd_1_code, prior_sd_1_args);
  target += std_normal_lpdf(to_vector(z_1));
  target += lkj_corr_cholesky_lpdf(L_1 | prior_cor_1_eta);
}
generated quantities {
  vector[nthres] Intercept_1 = Intercept_c_1 + dot_product(means_X_1, b_1);  // on the original scale
  matrix[M_1_1, M_1_1] Cor_1 = multiply_lower_tri_self_transpose(L_1);
}
