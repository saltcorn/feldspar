  matrix[N, K_1] Xc_1;
  for (i in 1:K_1) {
    means_X_1[i] = mean(X_1[, i]);
    Xc_1[, i] = X_1[, i] - means_X_1[i];
  }
}
parameters {
  vector[K_1] b_1;
  real Intercept_c_1;
  real<lower=0> phi;
}
model {
  vector[N] eta_1 = Intercept_c_1 + Xc_1 * b_1;
  vector[N] mu = inv_logit(eta_1);
  for (n in 1:N) {
    real lp;
    if (cens[n] == 0) {
      lp = beta_lpdf(Y[n] | mu[n] * phi, (1 - mu[n]) * phi);
    } else if (cens[n] == 1) {
      lp = beta_lccdf(Y[n] | mu[n] * phi, (1 - mu[n]) * phi);
    } else if (cens[n] == -1) {
      lp = beta_lcdf(Y[n] | mu[n] * phi, (1 - mu[n]) * phi);
    } else {
      lp = log_diff_exp(beta_lcdf(Y2[n] | mu[n] * phi, (1 - mu[n]) * phi), beta_lcdf(Y[n] | mu[n] * phi, (1 - mu[n]) * phi));
    }
    target += lp;
  }
  target += priors_lpdf(b_1 | prior_b_1_code, prior_b_1_args);
  target += prior_lpdf(Intercept_c_1 | prior_Intercept_1_code, prior_Intercept_1_args);
  target += prior_lpdf(phi | prior_phi_code, prior_phi_args);
